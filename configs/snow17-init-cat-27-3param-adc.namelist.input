&SNOW_CONTROL
dt = 3600
start_year = 2015
start_month = 10
start_day = 1
start_hour = 1
end_year = 2020
end_month = 9
end_day = 30
end_hour = 23
restart_flag = .false.
/

&SNOW_PARAMETER_FILE
parameter_file = 'configs/snow17-params-cat-27-3param-adc.txt'
/

&SNOW_OUTPUT
print_debug_flag = .false.
output_file = './output/snow17_cat-27_output.nc'
print_step = 24
/